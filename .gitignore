# ==========================================
# 1. UV & PYTHON ENVIRONMENT
# ==========================================
# uv automatically manages the .venv folder.
# We ignore the folder but keep the lockfile for reproducibility.
.venv/
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# 2. VS CODE SPECIFIC
# ==========================================
# Ignore the IDE workspace settings but keep recommended extensions/tasks
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ==========================================
# 3. ENVIRONMENT VARIABLES & SECRETS
# ==========================================
# NEVER commit your secrets
.env
.env.local
.env.*.local
*.secret
*.pem
*.key

# ==========================================
# 4. BUILD & DISTRIBUTION
# ==========================================
# uv uses pyproject.toml; build artifacts are usually in /dist
dist/
build/
*.egg-info/
*.egg
.eggs/

# ==========================================
# 5. TESTING & LINTING
# ==========================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# ==========================================
# 6. SYSTEM FILES
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# 7. LOGS AND DATABASES
# ==========================================
*.log
*.sqlite3
*.db